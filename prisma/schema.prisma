// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Modelling a database
model Resource {
  id        Int          @id @default(autoincrement())
  slug      String       @unique
  name      String
  type      ResourceType
  capacity  Int
  createdAt DateTime     @default(now())
  bookings  Booking[]

  // Linking to a building
  // buildingId Int? allows a resource to exist without a building (Null state).
  building   Building? @relation(fields: [buildingId], references: [id])
  buildingId Int?
}

enum ResourceType {
  room
  equipment
  sport
}

model Building {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  name      String
  resources Resource[]
}

model User {
  id       Int       @id @default(autoincrement())
  email    String    @unique
  name     String
  role     Role      @default(student)
  bookings Booking[]
}

enum Role {
  student
  admin
}

model Booking {
  id         Int      @id @default(autoincrement())
  startsAt   DateTime
  endsAt     DateTime
  // Linking to a resource
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  // Linking to a resource
  resource   Resource @relation(fields: [resourceId], references: [id])
  resourceId Int
  // ? = can be null
  note       String?
  createdAt  DateTime @default(now())

  @@index([resourceId, startsAt])
}
