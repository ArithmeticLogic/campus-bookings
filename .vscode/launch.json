{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Next Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    },
    {
      "name": "Run Prisma Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx prisma dev"
    },
    {
      "name": "Run Prisma Studio",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx prisma studio"
    },
    {
      "name": "Launch Integrated Browser",
      "type": "editor-browser",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Start Web App",
      "configurations": [
        "Run Next Dev",
        "Launch Integrated Browser",
        "Run Prisma Dev"
      ]
    }
  ]
}
